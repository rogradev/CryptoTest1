{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": "apps/api",
      "framework": "express",
      "entrypoint": "src/app.ts",
      "buildCommand": "npm --prefix ../.. run build:shared"
    },
    "web": {
      "root": "apps/web",
      "framework": "vite",
      "buildCommand": "npm --prefix ../.. run build:shared && npm run build",
      "outputDirectory": "dist"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "api" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "web" }
    }
  ]
}

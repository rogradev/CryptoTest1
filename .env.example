# ---------------------------------------------------------------
# Wallet prototype — environment configuration
# Copy to .env (or run `npm run setup:env`, which also generates
# a random WALLET_ENCRYPTION_KEY for you).
# ---------------------------------------------------------------

NODE_ENV=development

# PostgreSQL (matches docker-compose.yml)
DATABASE_URL=postgresql://wallet:wallet@localhost:5432/wallet_prototype

# API
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Solana — DEVNET ONLY. Any other cluster is rejected at startup.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet

# 32-byte master key used for AES-256-GCM encryption of wallet secrets.
# Base64 (44 chars) or hex (64 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes stored wallet secrets unrecoverable.
WALLET_ENCRYPTION_KEY=

# Temporary development identity (replaced by client auth later)
DEMO_USER_ID=demo-user-001

# Apply pending SQL migrations and seed the demo user on the first API request
# (needed for serverless deployments). Set to false to manage migrations manually.
DB_AUTO_MIGRATE=true

# --- Withdrawals (demo safety) --------------------------------------------
# Real Devnet withdrawals are OFF unless enabled here.
WITHDRAWALS_ENABLED=false
# Shared demo access code required to execute withdrawals (X-Withdrawal-Access-Code).
# Mandatory when WITHDRAWALS_ENABLED=true and NODE_ENV=production. Min 8 characters.
WITHDRAWAL_ACCESS_CODE=
# Maximum SOL per withdrawal.
WITHDRAWAL_MAX_SOL=1

# --- Deposit detection ------------------------------------------------------
# Background sync interval for the long-running server (npm run dev / npm start).
# Serverless deployments sync when the UI polls instead. 0 disables the loop.
DEPOSIT_SYNC_INTERVAL_MS=15000
